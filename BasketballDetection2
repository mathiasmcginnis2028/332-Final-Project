from ultralytics import YOLO
import cv2
import numpy as np

def AIDetect(frame): #given a frame, detects possible basketball locations
    results = model.predict(
            source=frame,
            conf=0.25,
        )
    return results
def BestAI(results): #given a list of possible basketball locations, find the best one
    for result in results:
         if len(result.boxes) > 0:
            best_box = max(result.boxes, key=lambda box: box.conf.item())
    
            x1, y1, x2, y2 = best_box.xyxy[0].tolist()
            return [x1,y1,x2,y2]
         else:
                return None
def HoughTrans(ball_window, frame):
    basketball_crop = frame[max(0,int(ball_window[1])-10):min(int(ball_window[3])+10,max_y),max(0,int(ball_window[0])-10):min(int(ball_window[2])+10,max_x)]
    gray = cv2.cvtColor(basketball_crop, cv2.COLOR_BGR2GRAY)
    gray = cv2.GaussianBlur(gray, (9, 9), 2)
    
    basketball_loco = cv2.HoughCircles(
        gray,
        cv2.HOUGH_GRADIENT,
        dp=1,
        param1 = 75,
        param2 = 25,
        minDist=20,
        minRadius=5,
        maxRadius=1000
        )
    if basketball_loco is not None:
        basketball_loco = np.round(basketball_loco[0]).astype(int)
        x, y, r = basketball_loco[0]
        x += max(0, int(ball_window[0]) - 10)
        y += max(0, int(ball_window[1]) - 10)
        return [x,y,r]
    else:
        return None




#load model
model = YOLO("runs/detect/train-5/weights/best.pt")
#load video
vid_name = input("Enter video name: ")
video = cv2.VideoCapture(vid_name)
frames = []
while True:
    ret, frame = video.read()
    if not ret:
        break
    frames.append(frame)

max_x = frames[0].shape[1]
max_y = frames[0].shape[0]
ball_data = []
drawn_frames = []
prev__window = None
prevprev_window = None


for frame in frames:
    results = AIDetect(frame)
    if len(results)>0:
        ball_window = BestAI(results)
        if ball_window == None:
            continue
    elif prev__window!=None&prevprev_window!=None:
        for i in range(len(prev__window)):
            ball_window[i] = 2*prev__window[i]-prevprev_window[i]
    else:
        continue

    ball_location = HoughTrans(ball_window,frame)
    if ball_location is None:
        x = int(ball_window[0]/2+ball_window[2]/2)
        y = int(ball_window[1]/2+ball_window[3]/2)
        width = ball_window[2] - ball_window[0]
        height = ball_window[3] - ball_window[1]
        r = max(1, int((width + height)/4))
        ball_location = [x, y, r]
    cv2.circle(frame, (int(ball_location[0]), int(ball_location[1])), int(ball_location[2]), (0, 255, 0), 2)
    drawn_frames.append(frame.copy())
    prevprev_window = prev__window
    prev__window = ball_window




fps = 30

fourcc = cv2.VideoWriter_fourcc(*'mp4v')

out = cv2.VideoWriter(
    "basketball.mp4",
    fourcc,
    fps,
    (max_x, max_y)
)

for frame in drawn_frames:
    out.write(frame)

video.release()
out.release()
